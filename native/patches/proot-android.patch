-		note(parent, WARNING, SYSTEM, "ptrace(GETEVENTMSG)");
-		return status;
+		int event_errno = status < 0 ? errno : EIO;
+		pid_t recovered = find_uninitialized_child(parent, clone_flags);
+		if (recovered <= 0) {
+			errno = event_errno;
+			note(parent, ERROR, SYSTEM,
+				"ptrace(GETEVENTMSG): child recovery failed (%d)", -recovered);
+			/* The event loop ignores new_child's return value. Its atexit
+			 * handler kills tracees; do not resume an untracked fork. */
+			exit(EXIT_FAILURE);
+		}
+		pid = (unsigned long) recovered;
+		VERBOSE(parent, 1,
+			"ptrace(GETEVENTMSG) unavailable; recovered child pid %lu from /proc",
+			pid);
 	}
 
 	child = get_tracee(parent, (pid_t) pid, true);
